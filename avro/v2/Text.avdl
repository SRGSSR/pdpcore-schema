@namespace("ch.srgssr.pdp.kafka.v2")
protocol Text {

    import idl "Language.avdl";

    /** Represents a human readable text for a corresponding asset. */
    record Text {
        /** The content of the text. */
        string content;
        /** The language of the text. */
        Language? language;
        /** The formatted content.  */
        FormattedContent? formatted = null;
    }

    record FormattedContent {
        /** The content containing formatting */
        string content;
        /** The type of formatting used (e.g. 'application/rtf')  */
        string contentType;
    }

}
